{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CheckMyDrive",
  "version": "0.1.0",
  "identifier": "com.humzasami.checkmydrive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CheckMyDrive",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Find out if a used drive is safe to buy or use",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/checkmydrive-engine"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "policykit-1",
          "smartmontools"
        ]
      }
    }
  }
}